<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Monero.Native</PackageId>
    <Version>$(MoneroNativeVersion)</Version>
    <Authors>Libmonero</Authors>
    <Description>Internal native runtime package for the monero-c .NET binding. Not intended for direct use.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/libmonero/monero-c</PackageProjectUrl>
    <RepositoryUrl>https://github.com/libmonero/monero-c.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../LICENSE" PackagePath="" />
    <Content Include="THIRD-PARTY-NOTICES.md" PackagePath="" />
    <Content Include="README.md" PackagePath="" />
    <Content Include="licenses/**/*" PackagePath="licenses/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="runtimes/win-x64/native/monero_c.dll" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes/win-x64/native/monero_c.dll')" />
    <Content Include="runtimes/win-x64/native/libusb-1.0.dll" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes/win-x64/native/libusb-1.0.dll')" />
    <Content Include="runtimes/linux-x64/native/libmonero_c.so" PackagePath="runtimes/linux-x64/native/" Condition="Exists('runtimes/linux-x64/native/libmonero_c.so')" />
    <Content Include="runtimes/linux-x64/native/libusb-1.0.so.0" PackagePath="runtimes/linux-x64/native/" Condition="Exists('runtimes/linux-x64/native/libusb-1.0.so.0')" />
    <Content Include="runtimes/linux-arm64/native/libmonero_c.so" PackagePath="runtimes/linux-arm64/native/" Condition="Exists('runtimes/linux-arm64/native/libmonero_c.so')" />
    <Content Include="runtimes/linux-arm64/native/libusb-1.0.so.0" PackagePath="runtimes/linux-arm64/native/" Condition="Exists('runtimes/linux-arm64/native/libusb-1.0.so.0')" />
    <Content Include="runtimes/osx-x64/native/libmonero_c.dylib" PackagePath="runtimes/osx-x64/native/" Condition="Exists('runtimes/osx-x64/native/libmonero_c.dylib')" />
    <Content Include="runtimes/osx-x64/native/libusb-1.0.0.dylib" PackagePath="runtimes/osx-x64/native/" Condition="Exists('runtimes/osx-x64/native/libusb-1.0.0.dylib')" />
    <Content Include="runtimes/osx-arm64/native/libmonero_c.dylib" PackagePath="runtimes/osx-arm64/native/" Condition="Exists('runtimes/osx-arm64/native/libmonero_c.dylib')" />
    <Content Include="runtimes/osx-arm64/native/libusb-1.0.0.dylib" PackagePath="runtimes/osx-arm64/native/" Condition="Exists('runtimes/osx-arm64/native/libusb-1.0.0.dylib')" />
  </ItemGroup>

</Project>
