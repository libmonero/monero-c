unded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3BfillColor%3D%23fff2cc%3BstrokeColor%3D%23d6b656%3Balign%3Dleft%3BverticalAlign%3Dtop%3Bspacing%3D8%3BfontSize%3D12%3BfontFamily%3DVerdana%3B%22%20value%3D%22%26lt%3Bb%26gt%3BHow%20to%20read%20the%20C%20tables%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BEvery%20function%20returns%20monero_result%3A%20MONERO_OK%2C%20or%20MONERO_ERROR%20with%20the%20message%20in%20monero_last_error%28%29%20and%20the%20kind%20in%20monero_last_error_code%28%29.%26lt%3Bbr%26gt%3BThe%20first%20parameter%20of%20a%20daemon%20or%20wallet%20function%20is%20its%20handle%2C%20monero_daemon%2A%20or%20monero_wallet%2A%2C%20and%20the%20rows%20leave%20it%20out.%20A%20result%20comes%20back%20in%20an%20out_%2A%20parameter%2C%20and%20the%20row%20gives%20its%20type%20after%20the%20colon.%20A%20model%20is%20JSON%20text%20with%20the%20field%20names%20of%20the%20types%20below%2C%20which%20the%20caller%20frees%20with%20monero_utils_free%28%29%2C%20and%20a%20secret%20is%20freed%20with%20monero_utils_free_secret%28%29.%20A%20parameter%20with%20%3Dnull%20is%20a%20pointer%2C%20and%20NULL%20means%20none.%22%20vertex%3D%221%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3CmxGeometry%20height%3D%22124%22%20width%3D%22814%22%20x%3D%2217.5%22%20y%3D%2210%22%20as%3D%22geometry%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%3C%2FmxCell%3E%0A%20%20%20%20%20%20%20%20%3CmxCell%20id%3D%22s672%22%20parent%3D%221%22%20style%3D%22text%3Bhtml%3D1%3Bresizable%3D0%3Bpoints%3D%5B%5D%3Bautosize%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3BspacingTop%3D-4%3BfontStyle%3D1%3BfontSize%3D16%3B%22%20value%3D%22Monero%20Daemon%20Types%201%2F3%20%28continued%29%22%20vertex%3D%221%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3CmxGeometry%20height%3D%2220%22%20width%3D%22310%22%20x%3D%2227.5%22%20y%3D%224426%22%20as%3D%22geometry%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%3C%2FmxCell%3E%0A%20%20%20%20%20%20%20%20%3CmxCell%20id%3D%22s673%22%20parent%3D%221%22%20style%3D%22text%3Bhtml%3D1%3Bresizable%3D0%3Bpoints%3D%5B%5D%3Bautosize%